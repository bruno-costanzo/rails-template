<% content_for :title, t(".title") %>

<div class="p-6 max-w-3xl mx-auto">
  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl"><%= t(".title") %></h1>
    <div class="flex items-center gap-2">
      <%= link_to t(".models"), models_path, class: "btn btn-ghost" %>
      <%= link_to t(".new_chat"), new_chat_path, class: "btn btn-primary" %>
    </div>
  </div>

  <% if @chats.any? %>
    <ul id="chats" class="list bg-base-100 rounded-box shadow">
      <% @chats.each do |chat| %>
        <li class="list-row items-center">
          <%= render chat %>
          <div class="flex gap-2">
            <%= link_to t(".show"), chat, class: "btn btn-ghost" %>
            <%= button_to t(".destroy"), chat, method: :delete, class: "btn btn-error", data: { turbo_confirm: t(".confirm") } %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-center my-10" id="chats"><%= t(".empty") %></p>
  <% end %>
</div>
