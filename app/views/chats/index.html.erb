<% content_for :title, "Chats" %>

<div class="p-6 max-w-3xl mx-auto">
  <% if notice.present? %>
    <p class="alert alert-success mb-5" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl">Chats</h1>
    <div class="flex items-center gap-2">
      <%= link_to "Models", models_path, class: "btn btn-ghost" %>
      <%= link_to "New chat", new_chat_path, class: "btn btn-primary" %>
    </div>
  </div>

  <% if @chats.any? %>
    <ul id="chats" class="list bg-base-100 rounded-box shadow">
      <% @chats.each do |chat| %>
        <li class="list-row items-center">
          <%= render chat %>
          <div class="flex gap-2">
            <%= link_to "Show", chat, class: "btn btn-ghost" %>
            <%= button_to "Destroy", chat, method: :delete, class: "btn btn-error", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-center my-10" id="chats">No chats found.</p>
  <% end %>
</div>
