<% content_for :title, t(".title") %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl"><%= t(".title") %></h1>

  <% if Current.user.messages_remaining_today.zero? %>
    <p class="text-sm opacity-70 my-5"><%= t("messages.composer.exhausted", count: User::DAILY_MESSAGE_LIMIT) %></p>
  <% else %>
    <%= render "form", chat: @chat %>
  <% end %>

  <%= link_to t(".back"), chats_path, class: "btn btn-ghost mt-2" %>
</div>
