<%= turbo_frame_tag "support_chat_photos", class: "shrink-0" do %>
  <%= form_with model: chat, url: support_chat_photos_path(chat), method: :post, data: { controller: "support-chat-photos" }, class: "contents" do |form| %>
    <%= form.label :pending_photos, class: "btn btn-ghost btn-xs btn-square", title: t(".attach") do %>
      <%= lucide_icon("paperclip", class: "size-4") %>
      <span class="sr-only"><%= t(".attach") %></span>
    <% end %>
    <%= form.file_field :pending_photos, multiple: true, accept: "image/*",
        class: "hidden",
        data: { action: "change->support-chat-photos#submit" } %>
  <% end %>

  <% if error %>
    <div class="alert alert-error alert-soft text-xs mb-2"><%= error %></div>
  <% end %>

  <% if chat.pending_photos.attached? %>
    <p class="text-xs opacity-70 mb-2"><%= t(".attached", count: chat.pending_photos.count) %></p>
  <% end %>
<% end %>
