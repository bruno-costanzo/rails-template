<%= turbo_frame_tag "support_chat" do %>
  <%= turbo_stream_from "chat_#{@chat.id}" %>

  <div id="chat_<%= @chat.id %>_messages" class="max-h-64 overflow-y-auto space-y-3 mb-3">
    <% @messages.each do |message| %>
      <%= render message %>
    <% end %>
  </div>

  <%= render "support_chats/photos", chat: @chat, error: nil %>

  <%= render "messages/form", chat: @chat, message: @message %>
<% end %>
