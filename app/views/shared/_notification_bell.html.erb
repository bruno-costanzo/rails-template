<div class="dropdown dropdown-end">
  <div tabindex="0" role="button" class="btn btn-ghost btn-circle" aria-label="Notifications">
    <div class="indicator">
      <%= lucide_icon("bell", class: "size-5") %>
      <% if unread_notifications_count.positive? %>
        <span class="badge badge-xs badge-primary indicator-item"><%= unread_notifications_count %></span>
      <% end %>
    </div>
  </div>
  <div tabindex="0" class="dropdown-content bg-base-100 rounded-box z-10 mt-3 w-80 p-2 shadow">
    <div class="flex items-center justify-between px-2 py-1">
      <span class="font-semibold">Notifications</span>
      <% if unread_notifications_count.positive? %>
        <%= button_to "Mark all read", mark_all_read_notifications_path, method: :patch, class: "btn btn-ghost btn-xs" %>
      <% end %>
    </div>
    <ul class="menu w-full">
      <% if recent_notifications.any? %>
        <% recent_notifications.each do |notification| %>
          <li><%= render "notifications/notification", notification: notification %></li>
        <% end %>
      <% else %>
        <li>
          <div class="flex flex-col items-center gap-2 py-6 text-base-content/60">
            <%= lucide_icon("bell-off", class: "size-6") %>
            <span>You're all caught up</span>
          </div>
        </li>
      <% end %>
    </ul>
    <div class="text-center mt-2">
      <%= link_to "See all", notifications_path, class: "link link-sm" %>
    </div>
  </div>
</div>
