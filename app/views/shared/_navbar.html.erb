<div class="navbar bg-base-100 shadow-sm">
  <div class="flex-1">
    <%= link_to "CharcoTemplate", root_path, class: "btn btn-ghost text-xl" %>
  </div>
  <div class="flex-none gap-2">
    <% if authenticated? %>
      <%= render "shared/notification_bell" %>
      <div class="dropdown dropdown-end">
        <div tabindex="0" role="button" class="btn btn-ghost btn-circle">
          <%= render "users/avatar", user: Current.user %>
        </div>
        <ul tabindex="0" class="menu dropdown-content bg-base-100 rounded-box z-10 mt-3 w-52 p-2 shadow">
          <li><%= link_to t("shared.navbar.chats"), chats_path %></li>
          <li><%= link_to t("shared.navbar.documents"), documents_path %></li>
          <li><%= link_to t("shared.navbar.profile"), edit_profile_path %></li>
          <li><%= link_to t("shared.navbar.sessions"), active_sessions_path %></li>
          <li><%= link_to t("shared.navbar.feedback"), new_feedback_path %></li>
          <li><%= button_to t("shared.navbar.sign_out"), session_path, method: :delete %></li>
        </ul>
      </div>
    <% else %>
      <%= link_to t("shared.navbar.sign_in"), new_session_path, class: "btn btn-ghost" %>
      <%= link_to t("shared.navbar.sign_up"), new_registration_path, class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
