<% set_meta_tags title: t(".meta_title"), description: t(".meta_description") %>
<div class="hero bg-base-200 min-h-[70vh]">
  <div class="hero-content text-center">
    <div class="max-w-xl">
      <h1 class="text-5xl font-bold"><%= t(".headline") %></h1>
      <p class="py-6"><%= t(".subheadline") %></p>
      <%= link_to t(".start"), new_registration_path, class: "btn btn-primary" %>
    </div>
  </div>
</div>
<div class="grid gap-6 md:grid-cols-3 p-10">
  <% t(".features").each do |feature| %>
    <div class="card bg-base-100 shadow">
      <div class="card-body">
        <h2 class="card-title"><%= feature[:title] %></h2>
        <p><%= feature[:body] %></p>
      </div>
    </div>
  <% end %>
</div>
