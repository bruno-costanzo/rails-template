<% content_for :title, t(".title") %>

<div class="w-full">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl"><%= t(".title") %></h1>
    <div class="flex items-center gap-2">
      <%= link_to t(".chats"), chats_path, class: "btn btn-ghost" %>
      <%= button_to t(".refresh"), refresh_models_path, method: :post, class: "btn btn-primary" %>
    </div>
  </div>

  <div id="models" class="mt-5 overflow-x-auto">
    <% if @models.any? %>
      <table class="table">
        <thead>
          <tr>
            <th><%= t(".provider") %></th>
            <th><%= t(".model") %></th>
            <th><%= t(".context_window") %></th>
            <th><%= t(".pricing") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @models.each do |model_info| %>
            <%= render "models/model",
              model: model_info %>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-center my-10"><%= t(".empty") %></p>
    <% end %>
  </div>

</div>
