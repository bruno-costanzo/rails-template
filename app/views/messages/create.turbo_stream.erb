<% if defined?(@chat) && @chat.present? && @user_message.present? %>
  <%= turbo_stream.append "chat_#{@chat.id}_messages" do %>
    <%= render @user_message %>
  <% end %>
  <%= turbo_stream.replace "composer" do %>
    <%= render "messages/composer", chat: @chat, message: @chat.messages.build %>
  <% end %>
<% end %>
