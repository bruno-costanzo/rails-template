OPENAI_API_KEY=sk-your-key-here

# Optional: user feedback -> GitHub Issues. Both must be set, or feedback is only stored locally.
# GITHUB_ISSUES_TOKEN=github_pat_your-fine-grained-token
# GITHUB_ISSUES_REPO=your-org/your-repo

# Optional: /errors dashboard basic auth. An unset password leaves /errors open.
# SOLID_ERRORS_USERNAME=admin
# SOLID_ERRORS_PASSWORD=a-strong-password
# SOLID_ERRORS_EMAIL_TO=you@example.com

# Optional: /admin/feedbacks panel. Access is denied until both are set.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=a-strong-password

# Optional: /onlylogs log viewer. Access is denied until both are set. Never commit real values; share one pair across apps via your password manager and .kamal/secrets.
# ONLYLOGS_BASIC_AUTH_USER=logs
# ONLYLOGS_BASIC_AUTH_PASSWORD=a-strong-password
