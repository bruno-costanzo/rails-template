#!/usr/bin/env ruby
require "bundler/setup"
require "pathname"
require "yaml"
require_relative "../lib/template/children"
require_relative "../lib/template/spawner"

name = ARGV.find { |arg| !arg.start_with?("--") } or abort("Usage: bin/spawn <name> [--github]")
root = File.expand_path("..", __dir__)

Template::Spawner.new(root: root, name: name, github: ARGV.include?("--github")).run

puts "Spawned #{name} at ../#{name} and registered it in children.yml"
